# Copy this file to .env and fill in your own values. NEVER commit the real .env.
DRUGSETU_API_KEY=your_api_key_here

# Optional overrides - check these against the API reference in your DrugSetu dashboard.
# Defaults are marked UNVERIFIED in drugsetu_client.py.
# DRUGSETU_API_BASE_URL=https://api.drugsetu.com/v1
# DRUGSETU_SEARCH_PATH=/products/search
# DRUGSETU_DETAIL_PATH=/products/{id}
# DRUGSETU_AUTH_HEADER=X-API-Key
# DRUGSETU_SEARCH_TYPE=

# Optional Google Programmable Search fallback. If not configured, users get a
# direct Google Search link when DrugSetu returns no matching record.
# Google Custom Search JSON API requires an existing eligible account and a Search Engine ID.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
